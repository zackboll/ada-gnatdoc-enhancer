project Layout_Controls is
   for Source_Dirs use (".", "../../src", "../../src/internal");
   for Object_Dir use "obj-" & external ("LAYOUT_PROFILE", "o0");
   for Exec_Dir use "bin-" & external ("LAYOUT_PROFILE", "o0");
   for Create_Missing_Dirs use "True";
   for Languages use ("Ada", "C");
   for Main use ("float16_boundary_controls.adb",
                  "representation_measurements.adb",
                  "production_negative_controls.adb",
                 "opencv-core-internal-object_size_negative.adb",
                 "opencv-core-internal-layout_guard_controls.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-Werror");
      for Switches ("opencv-core-internal-typed_access.adb") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-Werror");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror",
         "-I" & Layout_Controls'Project_Dir & "../../cpp");
   end Compiler;
   package Linker is
      for Switches ("Ada") use
        ("-Wl,--wrap=opencv_core_mat_create_external_2d",
         "-Wl,--wrap=opencv_core_mat_create_external_nd",
         "-Wl,--wrap=opencv_core_mat_create_external_2d_strided",
         "-Wl,--wrap=opencv_core_mat_create_external_nd_strided",
         "-Wl,--wrap=opencv_core_mat_destroy",
         "-Wl,--wrap=opencv_core_mat_acquire_borrow_lease",
         "-Wl,--wrap=opencv_core_mat_borrow_row_data",
         "-Wl,--wrap=opencv_core_mat_borrow_contiguous_data",
         external ("LAYOUT_SHIM", Layout_Controls'Project_Dir & "../../native-shim.o"),
         "-lopencv_core", "-lstdc++");
   end Linker;
end Layout_Controls;