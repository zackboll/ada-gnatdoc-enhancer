with "aunit";
with "../../opencv_core.gpr";
project All_Family_Controls is
   for Source_Dirs use (".", "../src", "../cpp");
   for Excluded_Source_Files use ("shim_header_probe.c");
   for Object_Dir use "obj-family";
   for Exec_Dir use "bin-family";
   for Create_Missing_Dirs use "True";
   for Languages use ("Ada", "C", "C++");
   for Main use ("all_family_controls.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-Werror");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror",
         "-I" & All_Family_Controls'Project_Dir & "../../cpp");
      for Default_Switches ("C++") use
        ("-std=c++17", "-Wall", "-Wextra", "-Werror",
         "-I" & All_Family_Controls'Project_Dir & "../../cpp",
         external ("LAYOUT_OPENCV_INCLUDE", "-I/usr/include/opencv4"));
   end Compiler;
   package Linker is
      for Switches ("Ada") use
        ("-Wl,--wrap=opencv_core_mat_create_external_2d",
         "-Wl,--wrap=opencv_core_mat_create_external_nd",
         "-Wl,--wrap=opencv_core_mat_create_external_2d_strided",
         "-Wl,--wrap=opencv_core_mat_create_external_nd_strided",
         "-Wl,--wrap=opencv_core_mat_destroy",
         "-Wl,--wrap=opencv_core_mat_acquire_borrow_lease",
         "-Wl,--wrap=opencv_core_mat_borrow_row_data",
         "-Wl,--wrap=opencv_core_mat_borrow_contiguous_data",
         "-L" & OpenCV_Core'Project_Dir & "lib",
         "-linteger_borrow_lifetime_probe");
   end Linker;
end All_Family_Controls;