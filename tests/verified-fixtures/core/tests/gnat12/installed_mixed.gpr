with "opencv_core";
project Installed_Mixed is
   for Languages use ("Ada", "C++");
   for Source_Dirs use (".");
   for Source_Files use ("installed_mixed_consumer.adb", "installed_application.cpp");
   for Main use ("installed_mixed_consumer.adb");
   for Object_Dir use "obj-mixed";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-Werror");
      for Driver ("C++") use "/usr/bin/g++";
      for Default_Switches ("C++") use
        ("-std=c++17", "-Wall", "-Wextra", "-Werror",
         external ("CONSUMER_INCLUDE", "-I/usr/include/opencv4"));
   end Compiler;
end Installed_Mixed;